<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BookMarket">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BookMarket"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ExamplesActivity"
            android:exported="true"
            android:label="@string/examples_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LayoutActivity" />
        <activity android:name=".MenuActivity" />
        <activity android:name=".chap03.TextViewActivity" />
        <activity android:name=".chap03.ButtonActivity" />
        <activity android:name=".chap03.ButtonProjectActivity" />
        <activity android:name=".chap03.EditTextActivity" />
        <activity android:name=".chap03.EditTextProjectActivity" />
        <activity android:name=".chap03.ImageViewActivity" />
        <activity android:name=".chap03.ImageButtonActivity" />
        <activity android:name=".chap03.UIActivity" />
        <activity android:name=".chap04.ConstraintLayoutProjectActivity" />
        <activity android:name=".chap04.LinearLayoutProjectActivity" />
        <activity android:name=".chap04.FrameLayoutProjectActivity" />
        <activity android:name=".chap04.TableLayoutProjectActivity" />
    </application>

</manifest>